# Usa una imagen base de NVIDIA con CUDA y Python preinstalados
# NVIDIA CUDA 11.8 es compatible con TensorFlow 2.15
# Ubuntu 20.04 es una base estable.
FROM nvidia/cuda:11.8.0-cudnn8-devel-ubuntu20.04

# Evita preguntas interactivas durante la instalación de paquetes
ENV DEBIAN_FRONTEND=noninteractive

# Instala software-properties-common para add-apt-repository,
# luego añade el PPA deadsnakes para versiones más recientes de Python.
# Después, instala Python 3.11, sus herramientas de desarrollo y venv,
# y otras dependencias de compilación.
# OMITIMOS python3-pip de aquí para instalarlo directamente con Python 3.11.
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y \
    python3.11 \
    python3.11-venv \
    python3.11-dev \
    python3.11-distutils \
    build-essential \
    wget \
    unzip \
    git \
    && rm -rf /var/lib/apt/lists/*

# Configura python3.11 como el python3 y python por defecto.
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 \
    && update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1

# Usa ensurepip para instalar pip para Python 3.11, luego actualízalo.
# Esto proporciona una instalación de pip más limpia y específica para python3.11.
RUN python3.11 -m ensurepip --upgrade \
    && python3.11 -m pip install --no-cache-dir --upgrade pip setuptools wheel

# Establece el directorio de trabajo
WORKDIR /app

# Copia los archivos de tu proyecto
# Optimiza copiando solo lo necesario
COPY requirements.txt .
COPY src/ /app/src/
COPY scripts/ /app/scripts/
# Si tienes otros directorios o archivos necesarios, cópialos aquí

# ---- INICIO: Instalación de TA-Lib C library ----
# Descarga, compila e instala la biblioteca TA-Lib C
RUN wget http://prdownloads.sourceforge.net/ta-lib/ta-lib-0.4.0-src.tar.gz && \
    tar -xzf ta-lib-0.4.0-src.tar.gz && \
    cd ta-lib/ && \
    ./configure --prefix=/usr && \
    make && \
    make install && \
    cd .. && \
    rm -rf ta-lib ta-lib-0.4.0-src.tar.gz
# ---- FIN: Instalación de TA-Lib C library ----

# (La instalación de requirements.txt la maneja tu script de gcp/04_build_docker_image.py)
RUN python3 -m pip install --no-cache-dir --upgrade setuptools wheel
# ya ha preparado setuptools y wheel, que son importantes para construir paquetes.

# Establece PYTHONPATH para que los módulos en src sean importables
ENV PYTHONPATH="/app:${PYTHONPATH}"

# Comando por defecto (ajusta según el punto de entrada de tu aplicación de entrenamiento)
CMD ["python3", "scripts/train_rl_agent.py"]