# Google Cloud Platform variables
GCP_PROJECT_ID=btcbot276299
GCP_REGION=europe-southwest1
GCP_ZONE=europe-west3-a

# Buckets para datos y modelos
RAW_DATA_BUCKET=btcbot-raw-data-btcbot276299
PROCESSED_DATA_BUCKET=btcbot-processed-data-btcbot276299
MODELS_STAGING_BUCKET=btcbot-models-staging-btcbot276299
EVALUATION_RESULTS_BUCKET=btcbot-evaluation-results-btcbot276299
PIPELINE_ROOT_BUCKET=gs://btcbot-models-staging-btcbot276299/pipeline_root

# Recursos IAM
SERVICE_ACCOUNT_NAME=btcbot-service-account

# Repositorio de Artifact Registry
ARTIFACT_REPO=btcbot-docker-repo

# Secretos en Secret Manager
BINANCE_API_KEY_SECRET_NAME=binance-api-key
BINANCE_API_SECRET_SECRET_NAME=binance-api-secret

# Nombres para imágenes Docker
PIPELINE_IMAGE_BASE_NAME=btcbot-pipeline

# Configuración de adquisición de datos
DEFAULT_SYMBOL=BTCUSDT
DEFAULT_INTERVAL=1h
DEFAULT_HISTORICAL_START_DATE=2020-01-01

# Configuración del agente RL (training)
AGENT_LEARNING_RATE=0.0003
AGENT_BUFFER_SIZE=100000
AGENT_BATCH_SIZE=256
AGENT_GAMMA=0.99
AGENT_TAU=0.005
AGENT_TRAIN_FREQ=1
AGENT_GRADIENT_STEPS=1
AGENT_LEARNING_STARTS=10000
PIPELINE_TOTAL_TIMESTEPS=500000

# Configuración del entorno de trading
INITIAL_EQUITY=10000.0
LEVERAGE=1
POSITION_SIZE_PERCENTAGE=0.2
TRADING_FEES=0.0004
SLIPPAGE=0.0001

# Configuración del preprocesamiento
SEQUENCE_LENGTH_L=96
NORM_WINDOW_MULTIPLIER=2

# Configuración de evaluación
EVAL_NUM_EPISODES=10

# Configuración adicional para el agente
AGENT_EVAL_FREQ=10000
AGENT_SAVE_FREQ=50000
AGENT_DEVICE=auto
# Para GPU específica: AGENT_DEVICE=cuda:0

# Nombres para Cloud Run, Cloud Functions y Cloud Scheduler
DATA_ACQUISITION_SCHEDULE="0 */6 * * *"  # Cada 6 horas
PIPELINE_SCHEDULE="0 0 * * 1"  # Cada lunes a medianoche
