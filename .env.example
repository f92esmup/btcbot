# Credenciales de Binance (pueden almacenarse en Secret Manager)
BINANCE_API_KEY_FUTURES=your_binance_api_key
BINANCE_API_SECRET_FUTURES=your_binance_api_secret

# Configuración de Google Cloud (OBLIGATORIO)
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=your-gcs-bucket-name
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# Configuración regional de Google Cloud
GCP_REGION=us-central1

# Nota importante: 
# - El script exige que se configuren las variables de Google Cloud
# - Si no se configuran, el script fallará con un mensaje de error
# - Las credenciales de Binance pueden estar en Secret Manager o en este archivo
# - Si se configuran en ambos lugares, se usarán las de Secret Manager
