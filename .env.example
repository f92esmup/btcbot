# Configuración de Google Cloud (OBLIGATORIO)
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=your-gcs-bucket-name

# Opciones para autenticación en Google Cloud (usar UNA de estas opciones)
# Opción 1: Archivo de credenciales JSON
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json
# Opción 2: Nombre de la cuenta de servicio (si estás en un entorno de GCP o usas ADC)
GOOGLE_SERVICE_ACCOUNT_NAME=my-service-account@project-id.iam.gserviceaccount.com
# Opción 3: Si ni GOOGLE_APPLICATION_CREDENTIALS ni GOOGLE_SERVICE_ACCOUNT_NAME están definidos,
#          se usará Application Default Credentials (ADC). Esto funciona si usaste:
#          - gcloud auth application-default login
#          - Estás ejecutando en un servicio de GCP que tiene permisos asignados (Compute Engine, Cloud Run, etc.)

# Configuración regional de Google Cloud
GCP_REGION=us-central1

# NOTA IMPORTANTE SOBRE CREDENCIALES:
# - Las credenciales de Binance (BINANCE_API_KEY_FUTURES, BINANCE_API_SECRET_FUTURES) 
#   se obtienen EXCLUSIVAMENTE de Google Cloud Secret Manager
# - Debes crear estos secretos en la consola de Google Cloud con los mismos nombres:
#   https://console.cloud.google.com/security/secret-manager
# - El script fallará si no puede acceder a estos secretos
# - NO se intentará leer estas credenciales de variables de entorno locales
