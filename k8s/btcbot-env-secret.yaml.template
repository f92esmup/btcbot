# k8s/btcbot-env-secret.yaml.template
# This is a template for the Kubernetes Secret that will hold environment variables.
# In a CI/CD pipeline (like Cloud Build), the 'stringData' values would typically be
# populated from build arguments, Cloud Build substitutions, or a secure source.
# Actual sensitive secrets (like API keys) should still be managed via
# Google Cloud Secret Manager and accessed by the application directly.

apiVersion: v1
kind: Secret
metadata:
  name: btcbot-env-vars # Name of the Kubernetes Secret resource
type: Opaque # Default type for arbitrary user-defined data
stringData: # Allows you to specify secret data as strings
  # --- General GCP Configuration ---
  GCP_PROJECT_ID: "YOUR_GCP_PROJECT_ID" # To be replaced by Cloud Build substitution e.g. ${_GCP_PROJECT_ID}
  GCS_BUCKET_NAME: "YOUR_GCS_BUCKET_NAME" # To be replaced by Cloud Build substitution e.g. ${_GCS_BUCKET_NAME}
  GCP_REGION: "europe-south1" # Default or replace by substitution e.g. ${_GCP_REGION}
  BIGQUERY_LOG_DATASET_ID: "YOUR_BQ_LOG_DATASET_ID" # To be replaced by Cloud Build substitution e.g. ${_BIGQUERY_LOG_DATASET_ID}

  # --- Application Specific Configuration ---
  USE_TESTNET: "true" # Or "false". To be replaced by Cloud Build substitution if needed.
  LOG_LEVEL: "INFO" # e.g., DEBUG, INFO, WARNING, ERROR
  PYTHONUNBUFFERED: "1" # Recommended for Python applications in Docker for better logging

  # --- Add other non-sensitive environment variables required by your scripts ---
  # Example: If your scripts need a specific configuration file name from env
  # CONFIG_FILE_NAME: "src/config.yaml"
