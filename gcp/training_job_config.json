{
  "display_name": "btcbot-training-pipeline-ew4-cpu",
  "job_spec": {
    "worker_pool_specs": [
      {
        "machine_spec": {
          "machine_type": "n1-standard-4"
        },
        "replica_count": 1,
        "container_spec": {
          "image_uri": "europe-southwest1-docker.pkg.dev/btcbot-461022/btcbotrepo/btcbot-cpu:latest",
          "command": ["python"],
          "args": ["scripts/orchestrate_training.py", "--timesteps", "10000"],
          "env": [
            {
              "name": "GCP_PROJECT_ID",
              "value": "btcbot-461022"
            },
            {
              "name": "GCS_BUCKET_NAME", 
              "value": "btcbot-training-ew4"
            },
            {
              "name": "BIGQUERY_LOG_DATASET_ID",
              "value": "btcbot_logs"
            }
          ]
        }
      }
    ],
    "service_account": "btcbot-compute-sa@btcbot-461022.iam.gserviceaccount.com"
  }
}
