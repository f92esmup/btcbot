# Dockerfile for CPU-based image (for data download, preprocessing)
FROM python:3.11-slim

WORKDIR /app

# Copiar los archivos de requisitos primero para aprovechar la cache de Docker
COPY requirements.txt .

# Instalar las dependencias (excluyendo PyTorch completo, usando la versión CPU)
RUN pip install --no-cache-dir $(grep -v "torch==" requirements.txt) && \
    pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

# Instalar dependencias de GCP
RUN pip install --no-cache-dir google-cloud-secret-manager google-cloud-bigquery google-cloud-storage pandas-gbq db-dtypes

# Copiar el resto del código
COPY . .

# Configuraciones para contenedor
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV GOOGLE_APPLICATION_CREDENTIALS=/app/google-credentials.json

# El comando se proporciona durante la ejecución con docker run
CMD ["python", "-c", "print('Imagen CPU lista. Especifique un comando para ejecutar.')"]